{
  "source_snapshot": {
    "api.proto": "p1",
    "web.ts": "w1",
    "server.py": "s1",
    "logo.svg": "l1",
    "server-assets.json": "a1",
    "manual.md": "m1",
    "release-notes.md": "r1"
  },
  "tasks": [
    {
      "id": "G",
      "tool": "schema-codegen@sha256:gen1",
      "command": [
        "schema-codegen",
        "--js",
        "gen/api.js",
        "--python",
        "gen/api.py",
        "api.proto"
      ],
      "source_inputs": [
        "api.proto"
      ],
      "artifact_inputs": [],
      "env": {},
      "outputs": {
        "gen/api.js": "j1",
        "gen/api.py": "y1"
      }
    },
    {
      "id": "W",
      "tool": "webc@sha256:web1",
      "command": [
        "webc",
        "--mode",
        "release",
        "web.ts",
        "gen/api.js",
        "-o",
        "out/web.js"
      ],
      "source_inputs": [
        "web.ts"
      ],
      "artifact_inputs": [
        "gen/api.js"
      ],
      "env": {
        "FEATURE_PROFILE": "standard"
      },
      "outputs": {
        "out/web.js": "wb1"
      }
    },
    {
      "id": "S",
      "tool": "pybundle@sha256:py1",
      "command": [
        "pybundle",
        "server.py",
        "gen/api.py",
        "-o",
        "out/server.bin"
      ],
      "source_inputs": [
        "server.py"
      ],
      "artifact_inputs": [
        "gen/api.py"
      ],
      "env": {},
      "outputs": {
        "out/server.bin": "sb1"
      }
    },
    {
      "id": "PW",
      "tool": "pack@sha256:pack1",
      "command": [
        "pack",
        "--format",
        "tar",
        "out/web.js",
        "logo.svg",
        "-o",
        "out/web.tar"
      ],
      "source_inputs": [
        "logo.svg"
      ],
      "artifact_inputs": [
        "out/web.js"
      ],
      "env": {},
      "outputs": {
        "out/web.tar": "wp1"
      },
      "target": "web-package"
    },
    {
      "id": "PS",
      "tool": "pack@sha256:pack1",
      "command": [
        "pack",
        "--format",
        "tar",
        "out/server.bin",
        "server-assets.json",
        "-o",
        "out/server.tar"
      ],
      "source_inputs": [
        "server-assets.json"
      ],
      "artifact_inputs": [
        "out/server.bin"
      ],
      "env": {},
      "outputs": {
        "out/server.tar": "sp1"
      },
      "target": "server-package"
    },
    {
      "id": "L",
      "tool": "legacy-docs@sha256:doc1",
      "command": [
        "legacy-docs",
        "--html",
        "manual.md",
        "-o",
        "out/docs.html"
      ],
      "known_inputs": [
        "manual.md"
      ],
      "dependencies_complete": false,
      "artifact_inputs": [],
      "env": {
        "LANG": "zh_CN.UTF-8"
      },
      "outputs": {
        "out/docs.html": "d1"
      },
      "target": "docs"
    }
  ]
}

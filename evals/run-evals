#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "digest"
require "json"
require "open3"
require "optparse"
require "pathname"
require "tmpdir"
require "time"
require "yaml"

repo_root = File.expand_path("..", __dir__)
options = {
  engine: "codex",
  iteration: 1,
  parallelism: 1,
  skill_context: "auto",
  timeout: 1200,
  skill_up: "skill-up"
}

parser = OptionParser.new do |parser|
  parser.banner = "Usage: evals/run-evals [options] [skill-name ...]"
  parser.on("--skill-up PATH", "Skill-Up executable") { |value| options[:skill_up] = value }
  parser.on("--engine NAME", "Agent engine (default: codex)") { |value| options[:engine] = value }
  parser.on("--model NAME", "Runner model") { |value| options[:model] = value }
  parser.on("--judge-model NAME", "Judge model (default: runner model)") { |value| options[:judge_model] = value }
  parser.on("--iteration N", Integer, "Runs per case (default: 1)") { |value| options[:iteration] = value }
  parser.on("--parallelism N", Integer, "Cases per Skill to run concurrently (default: 1)") { |value| options[:parallelism] = value }
  parser.on("--skill-context MODE", "Skill installation: auto, target, or repository (default: auto)") { |value| options[:skill_context] = value }
  parser.on("--timeout SECONDS", Integer, "Total agent and judge timeout per case (default: 1200)") { |value| options[:timeout] = value }
  parser.on("--output-root DIR", "Result directory; required for a real run") { |value| options[:output_root] = File.expand_path(value) }
  parser.on("--case GLOB", "Only run matching case names") { |value| (options[:cases] ||= []) << value }
  parser.on("--dry-run", "Materialize and validate without model calls") { options[:dry_run] = true }
  parser.on("--verbose", "Enable Skill-Up debug output") { options[:verbose] = true }
end
begin
  parser.parse!
rescue OptionParser::ParseError => e
  abort "#{e.message}\n#{parser}"
end

abort "--model is required" unless options[:model]
abort "--iteration must be positive" unless options[:iteration].positive?
abort "--parallelism must be positive" unless options[:parallelism].positive?
abort "--skill-context must be auto, target, or repository" unless %w[auto target repository].include?(options[:skill_context])
abort "--timeout must be positive" unless options[:timeout].positive?
abort "--output-root is required for a real run" unless options[:dry_run] || options[:output_root]

options[:judge_model] ||= options[:model]

repository_skill_dirs = Dir[File.join(repo_root, "skills/*/*/SKILL.md")].sort.map { |path| File.dirname(path) }
abort "duplicate repository Skill names" unless repository_skill_dirs.map { |path| File.basename(path) }.uniq.length == repository_skill_dirs.length
skill_dirs = if ARGV.empty?
               repository_skill_dirs.select { |path| File.file?(File.join(path, "evals/evals.json")) }
             else
               ARGV.map do |name|
                 if name.include?(File::SEPARATOR)
                   File.expand_path(name)
                 else
                   repository_skill_dirs.find { |path| File.basename(path) == name } || abort("unknown Skill: #{name}")
                 end
               end
             end

eval_targets = skill_dirs.map do |skill_dir|
  evals_path = File.join(skill_dir, "evals/evals.json")
  abort "missing eval set: #{evals_path}" unless File.file?(evals_path)

  [skill_dir, JSON.parse(File.read(evals_path))]
rescue JSON::ParserError => e
  abort "invalid eval set: #{evals_path} (#{e.message})"
end

duplicate_targets = eval_targets.group_by { |_skill_dir, evals| evals.fetch("skill_name") }.select { |_name, targets| targets.length > 1 }.keys
abort "duplicate evaluation targets: #{duplicate_targets.join(', ')}; specify each Skill only once" unless duplicate_targets.empty?

def fixture_content(skill_dir, relative_path)
  source = File.expand_path(relative_path, skill_dir)
  allowed_prefix = skill_dir + File::SEPARATOR
  abort "fixture escapes Skill root: #{relative_path}" unless source.start_with?(allowed_prefix)
  abort "fixture does not exist: #{source}" unless File.file?(source)

  # Skill-Up context.files contains text, not YAML binary values.
  content = File.read(source, encoding: "UTF-8")
  abort "fixture is not valid UTF-8 text: #{relative_path}" unless content.valid_encoding? && !content.include?("\0")
  content
end

def file_hashes(directory)
  Dir.glob(File.join(directory, "**", "*"), File::FNM_DOTMATCH).sort.select { |path| File.file?(path) }.to_h do |path|
    [Pathname.new(path).relative_path_from(Pathname.new(directory)).to_s, Digest::SHA256.file(path).hexdigest]
  end
end

def executable_version(executable)
  output, status = Open3.capture2e(executable, "--version")
  # Keep only a version identifier, never arbitrary CLI output or environment data.
  status.success? ? output[/\b\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?\b/] || "unknown" : "unknown"
rescue SystemCallError
  "unknown"
end

# Reject the known evidence gap before spending tokens or producing misleading reports.
if options.fetch(:engine) == "codex" && !options[:dry_run]
  unsupported = eval_targets.flat_map do |_skill_dir, evals|
    evals.fetch("evals").map do |item|
      case_id = "case-#{item.fetch('id')}"
      selected = options.fetch(:cases, []).empty? || options.fetch(:cases).any? { |pattern| File.fnmatch?(pattern, case_id) }
      needs_worker = item.fetch("expectations").any? { |text| text.match?(/\A\[(?:single-)?worker-roundtrip\]/) }
      "#{evals.fetch('skill_name')}/#{case_id}" if selected && needs_worker
    end.compact
  end
  abort "证据不可用：Skill-Up 的 Codex 通道不能完整提供 Worker 交接与返回；未运行 #{unsupported.join(', ')}。请用 --case 选择其他用例，或在能提供所需证据的执行环境验证。" unless unsupported.empty?
end

unless options[:dry_run]
  eval_targets.each do |_skill_dir, evals|
    output_dir = File.join(options.fetch(:output_root), evals.fetch("skill_name"))
    next unless File.exist?(output_dir)

    abort "result directory is not empty; use a new --output-root: #{output_dir}" unless File.directory?(output_dir) && Dir.empty?(output_dir)
  end
end

failed_skills = []
eval_targets.each do |skill_dir, evals|
  skill_name = evals.fetch("skill_name")
  Dir.mktmpdir(".skill-up-", File.join(skill_dir, "evals")) do |runtime_dir|
    unless system(options.fetch(:skill_up), "import", File.join(skill_dir, "evals/evals.json"), "--output", runtime_dir, out: File::NULL)
      abort "Skill-Up import failed: #{skill_name}"
    end

    evals.fetch("evals").each do |item|
      case_path = File.join(runtime_dir, "cases/case-#{item.fetch('id')}.yaml")
      case_config = YAML.safe_load(File.read(case_path))
      # Imported expected_output is grading guidance, not task context.
      case_config["description"] = "#{skill_name}/case-#{item.fetch('id')}"
      # Native import leaves path placeholders; context.files requires actual text.
      context_files = item.fetch("files", []).to_h { |path| [path, fixture_content(skill_dir, path)] }
      if options.fetch(:engine) == "codex"
        abort "fixture reserves AGENTS.md for the Codex adapter" if context_files.key?("AGENTS.md")
        context_files["AGENTS.md"] = <<~MARKDOWN
          # Skill evaluation harness

          The user explicitly invokes `$#{skill_name}`. The root task agent must
          read `.agents/skills/#{skill_name}/SKILL.md` completely before acting.
          Check that path before claiming the Skill is unavailable. This instruction
          controls Skill loading only; the user prompt and authorization still govern.
          Delegated Workers follow their bounded handoff, not the root agent's role,
          and read any professional Skill explicitly invoked in that handoff.
        MARKDOWN
        context_files["AGENTS.md"] += "Before loading Supervisor, any user-visible notice must describe the task purpose without announcing Skill reads or internal control mechanics.\n" if skill_name == "supervisor"
      end
      case_config["context"]["files"] = context_files
      case_config["judge"]["model"] = options.fetch(:judge_model)
      case_config["expect"] = { "exit_code" => 0 }
      artifacts = item.fetch("files", []).dup
      item.fetch("expectations").each do |expectation|
        match = expectation.match(/\A\[(checkpoint-markdown|artifact-markdown|artifact-json|checkpoint-absent) path=([^\s\]]+)\]/)
        next unless match

        kind, path = match.captures
        relative = Pathname.new(path)
        abort "artifact path must stay inside the workspace: #{path}" if relative.absolute? || relative.each_filename.include?("..")
        key = kind == "checkpoint-absent" ? "files_not_exist" : "files_exist"
        (case_config["expect"][key] ||= []) << path
        artifacts << path unless kind == "checkpoint-absent"
      end
      case_config["collect_artifacts"] = artifacts.uniq
      File.write(case_path, YAML.dump(case_config))
    end

    eval_path = File.join(runtime_dir, "eval.yaml")
    config = YAML.safe_load(File.read(eval_path))
    context = options.fetch(:skill_context)
    context = skill_name == "supervisor" ? "repository" : "target" if context == "auto"
    installed_dirs = [skill_dir]
    installed_dirs |= repository_skill_dirs if context == "repository"
    config["skills"] = installed_dirs.map do |path|
      # Keep grading answers and unrelated fixtures out of the agent's Skill.
      # Copy entries individually: runtime_dir itself lives under evals/.
      runtime_skill = File.join(runtime_dir, "skills", File.basename(path))
      FileUtils.mkdir_p(runtime_skill)
      Dir.children(path).reject { |entry| %w[evals .git].include?(entry) }.each do |entry|
        FileUtils.cp_r(File.join(path, entry), runtime_skill)
      end
      ref = { "source" => "local_path", "path" => runtime_skill }
      ref["target"] = ".agents/skills/#{File.basename(path)}" if options.fetch(:engine) == "codex"
      ref
    end
    config["engine"] = { "name" => options.fetch(:engine), "model" => { "name" => options.fetch(:model) } }
    config["cases"]["defaults"]["timeout_seconds"] = options.fetch(:timeout)
    config["cases"]["parallelism"] = options.fetch(:parallelism)
    config["judge"] = { "type" => "agent_judge", "model" => options.fetch(:judge_model), "pass_threshold" => 1.0 }
    config["benchmark"] = { "enabled" => false }
    config["report"] = { "formats" => ["json"], "artifacts" => ["transcript"] }
    File.write(eval_path, YAML.dump(config))

    command = [options.fetch(:skill_up), "run", eval_path]
    if options[:dry_run]
      command << "--dry-run"
    else
      output_dir = File.join(options.fetch(:output_root), skill_name)
      FileUtils.mkdir_p(output_dir)
      selected_cases = Dir[File.join(runtime_dir, "cases/*.yaml")].sort.select do |path|
        options.fetch(:cases, []).empty? || options.fetch(:cases).any? { |pattern| File.fnmatch?(pattern, File.basename(path, ".yaml")) }
      end
      manifest = {
        schema_version: 1,
        created_at: Time.now.utc.iso8601,
        evidence_scope: "Materialized inputs supplied to Skill-Up; installation and Skill loading require execution evidence.",
        skill: skill_name,
        engine: options.fetch(:engine), model: options.fetch(:model), judge_model: options.fetch(:judge_model),
        timeout_seconds: options.fetch(:timeout), iteration: options.fetch(:iteration), parallelism: options.fetch(:parallelism),
        skill_context: context, case_filters: options.fetch(:cases, []),
        runner: { sha256: Digest::SHA256.file(__FILE__).hexdigest, ruby_version: RUBY_VERSION },
        codex_home: options.fetch(:engine) == "codex" ? "isolated_per_skill_run" : nil,
        skill_up_version: executable_version(options.fetch(:skill_up)),
        skills: config.fetch("skills").map do |ref|
          { name: File.basename(ref.fetch("path")), target: ref["target"], files_sha256: file_hashes(ref.fetch("path")) }
        end,
        cases: selected_cases.to_h do |path|
          item = YAML.safe_load(File.read(path))
          [File.basename(path, ".yaml"), {
            sha256: Digest::SHA256.file(path).hexdigest,
            context_files_sha256: item.fetch("context").fetch("files").transform_values { |text| Digest::SHA256.hexdigest(text) }
          }]
        end,
        harness_sha256: Digest::SHA256.file(eval_path).hexdigest
      }
      File.write(File.join(output_dir, "run-metadata.json"), JSON.pretty_generate(manifest) + "\n", mode: "wx")
      puts "Results: #{output_dir}"
      command.concat(["--iteration", options.fetch(:iteration).to_s, "--output-dir", output_dir])
    end
    options.fetch(:cases, []).each { |pattern| command.concat(["--include-case-name", pattern]) }
    command << "--verbose" if options[:verbose]
    puts "\n==> #{skill_name}"
    if options.fetch(:engine) == "codex" && !options[:dry_run]
      # 临时用例目录的 trust 记录只写入隔离目录，同时复用本机登录。
      Dir.mktmpdir("skill-up-codex-home-") do |eval_codex_home|
        host_codex_home = File.expand_path(ENV.fetch("CODEX_HOME", File.join(Dir.home, ".codex")))
        auth_file = File.join(host_codex_home, "auth.json")
        File.symlink(auth_file, File.join(eval_codex_home, "auth.json")) if File.file?(auth_file)
        failed_skills << skill_name unless system({ "CODEX_HOME" => eval_codex_home }, *command, chdir: skill_dir)
      end
    else
      failed_skills << skill_name unless system(*command, chdir: skill_dir)
    end
  end
end
abort "Skill evaluation failed: #{failed_skills.join(', ')}" unless failed_skills.empty?
